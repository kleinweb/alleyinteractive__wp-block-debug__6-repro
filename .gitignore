/wp-content/plugins/*
!/wp-content/plugins/.gitkeep
/wp-content/themes/*
!/wp-content/themes/.gitkeep

# Must-Use Plugins: track file, ignore dir
/wp-content/mu-plugins/*/

/wp-content/cache
/wp-content/upgrade
/wp-content/uploads
!/wp-content/uploads/.gitkeep

# WordPress Core
/wp-admin/
/wp-content/languages
/wp-includes/
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
# These will be modified by core during updates:
/index.php
/wp-content/index.php
/wp-content/plugins/index.php
/wp-content/themes/index.php

# WordPress Core in a subdirectory:
/wp/

# Allow wp-config.php; secrets offloaded to environment
# !/wp-config.php

# Data/logs/testing
.data
*.log
*.sql
/test-results/
/playwright-report/
/blob-report/

# Secrets
auth.json
.env
.env.*
!.env.example
.ssh
*.key
*.pem

# Dependencies
node_modules
vendor

# Context-specific
*.cache
*.local
*.local.*
*.local.*
!*.local*.example
.direnv
.pre-commit-config.yaml

# Plugin: Query Monitor
# This is a symbolic link whose path will vary per-environment.
/wp-content/db.php

# Build artifacts
hot
result

# Editor
/.idea/
